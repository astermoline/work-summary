# User Configuration
USER_NAME="Nick Moline"

# Gemini API Configuration (Google AI Studio)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Optional: Comma-separated backup models if primary model returns 503/429 or times out
# GEMINI_FALLBACK_MODELS="gemini-4-argon,gemini-3.6-flash,gemini-3.5-flash"

# GitHub Integration
GITHUB_USERNAME=""
GITHUB_TOKEN=""
# Optional: Restrict GitHub PR search and commit/merge inspection to a specific GitHub organization
# GITHUB_ORG=""

# Linear Integration
LINEAR_TOKEN=""

# Fathom.video Integration
FATHOM_TOKEN=""

# Slack Integration (User OAuth Token: xoxp-...)
SLACK_USER_TOKEN=""

# Google Calendar / Gmail / Drive Integration (OAuth 2.0 Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3048/oauth2callback"
# Optional: Gmail label to watch for explicit mentions (defaults to explicit-mention)
# GMAIL_MENTION_LABEL="explicit-mention"

# Optional: Custom directory path for arbitrary transcripts (defaults to arbitrary-transcripts)
# TRANSCRIPTS_DIR="arbitrary-transcripts"

# Optional: Only include Cursor Brain chats and plans from workspaces under this directory (leave blank for all workspaces)
# CURSOR_WORKSPACE_ROOT="~/workspace/my-company"

# Optional: Custom directory path for Cursor projects/transcripts (defaults to ~/.cursor/projects)
# CURSOR_PROJECTS_DIR="~/.cursor/projects"

# Optional: Custom directory path for Cursor plans (defaults to ~/.cursor/plans)
# CURSOR_PLANS_DIR="~/.cursor/plans"


